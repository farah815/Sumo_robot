<?xml version="1.0"?>
<robot name="sumo_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="body">
        <visual>
            <geometry>
               <mesh filename="package://sumo_description/meshes/STLs/body.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        
        <collision>
            <geometry>
                <mesh filename="package://sumo_description/meshes/STLs/body.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>

      <inertial>
         <origin xyz="0.00 0.05 -0.03" rpy="0 0 0"/>
         <mass value="10.26"/>
         <inertia ixx="0.20" ixy="0.0" ixz="0.0" iyy="0.28" iyz="-0.04" izz="0.15"/>
      </inertial>
    </link>


    <link name="cutting_wheel">
        <visual>
            <origin xyz="-0.014 -0.124 -0.073" rpy="0 0 0"/>
            <geometry>
               <mesh filename="package://sumo_description/meshes/STLs/cutting_wheel_final.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        
        <collision>
            <origin xyz="-0.014 -0.124 -0.073" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.106" length="0.01"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.01938 0.10888 0.08419" rpy="0 0 0"/>
            <mass value="0.17182"/>
            <inertia ixx="0.000470" ixy="0.0" ixz="0.0" iyy="0.000821" iyz="-0.000202" izz="0.000587"/>
        </inertial>
    </link>


    <joint name="cutting_wheel_joint" type="continuous">
        <parent link="body"/> 
        <child link="cutting_wheel"/>
        <origin xyz="0.003 0.08986 0.09845" rpy="0 0.52359 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="500.0" velocity="20.0"/>
    </joint>

</robot>